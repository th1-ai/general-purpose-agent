{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Edit(./runs/LOG.md)"
    ],
    "deny": [
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(rm *)",
      "Bash(git push *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
